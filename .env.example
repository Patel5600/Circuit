# ============================================================
# Circuit Protocol - Environment Configuration
# ============================================================
# Copy to .env.local and fill in values.
# NEVER commit .env.local or any file containing private keys.
# ============================================================

# -- Cluster Configuration --
VITE_CLUSTER=devnet
VITE_RPC_URL=https://api.devnet.solana.com

# -- Program & Account Addresses --
# Populated by `npm run setup:devnet`, which also writes devnet/deployment.json.
VITE_PROGRAM_ID=Cq4Lvd6Kgr3a2aP6ENPVGQ8tUpbkGmoWr9ZDBdXGiTs2
VITE_EQUITY_MINT=
VITE_QUOTE_MINT=

# 32-byte Pyth feed id (hex, no 0x prefix) for the collateral asset.
# Browse ids at https://www.pyth.network/developers/price-feed-ids
#
# Defaults to SOL/USD because Pyth actively sponsors it on devnet (confirmed
# live with `npx ts-node scripts/check-oracle.ts`). Equity feeds are generally
# NOT sponsored on devnet, so pick a feed that check-oracle reports as USABLE
# or the borrow / liquidate / refresh_guard paths cannot run.
VITE_PYTH_FEED_ID=ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d

# The PriceUpdateV2 account the program reads. `setup:devnet` derives the
# sponsored-feed address and verifies it exists; override only if you post your
# own price updates.
VITE_PYTH_PRICE_ACCOUNT=

# -- Pyth Configuration --
# Pyth Solana Receiver program. This is the owner the program requires on any
# PriceUpdateV2 account, and it is taken from pyth-solana-receiver-sdk v2.0.0
# with the `pro-compatible` feature OFF (which is how this program builds).
# Do not substitute the pro-compatible id (rec2HHDD...) or account
# deserialization will fail before any protocol logic runs.
VITE_PYTH_RECEIVER_PROGRAM=rec5EKMGg6MxZYaMdyBfgwp4d5rB9T1VQH5pJv5LtFJ

# Pyth push-oracle program that owns sponsored price feed accounts.
VITE_PYTH_PUSH_ORACLE=pythWSnswVUd12oZpeFP8e9CVaEqJg25g1Vtc2biRsT

# Hermes endpoint for fetching price updates client-side.
VITE_PYTH_HERMES_URL=https://hermes.pyth.network

# -- Server-Side Runtime Secrets (Vercel Serverless / Production & Preview) --
# MUST NOT be prefixed with VITE_. Never exposed to the browser client bundle.

# Google Gemini API key (supports Pro accounts from Google AI Studio).
# Configure in Vercel Project Settings > Environment Variables:
GEMINI_AI_KEY=
# Fallback local/server variable name:
GEMINI_API_KEY=
# Model name: client selectable in chat UI (gemini-1.5-pro, gemini-2.0-flash, gemini-1.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-1.5-pro

# Serverless Devnet Faucet Minting Authority (64-byte keypair JSON array or comma-separated).
# Required for /api/faucet. Faucet strictly uses this key and NEVER falls back to DEPLOYER_KEYPAIR.
FAUCET_AUTHORITY_KEY=

# Autonomous Agent execution signer key (serverless / daemon executor only).
AGENT_SIGNER_SECRET=

# -- Local Operator Tooling & Devnet Setup (LOCAL SCRIPTS ONLY) --
# DO NOT add these variables to Vercel production or preview environments!
# Used exclusively by local scripts (scripts/setup-devnet.ts, scripts/deploy-devnet.sh).

# Path to the local deployer keypair.
DEPLOYER_KEYPAIR=~/.config/solana/id.json

# Initial lendable quote liquidity to mint into the protocol vault, in whole
# tokens (6 decimals applied by the script).
SETUP_LIQUIDITY=100000

# Test collateral to mint to the deployer, in whole tokens.
SETUP_COLLATERAL=1000

# max_oracle_age (seconds) registered for the asset, and the staleness bound the
# tooling uses when judging feed usability.
#
# Devnet sponsored feeds are pushed only every few minutes (observed ages of
# 198s and 291s for SOL/USD), so a mainnet-style bound of 30-60s makes borrow
# fail almost always on devnet. 600s is a demo-appropriate value; tighten it
# substantially for production.
SETUP_MAX_ORACLE_AGE=600
